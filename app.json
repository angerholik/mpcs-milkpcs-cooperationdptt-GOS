{
  "expo": {
    "name": "milk-pcs-expo",
    "slug": "milk-pcs-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "in.gov.sikkim.cooperation.core",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Milk PCS Reporting",
      "shortName": "Milk PCS",
      "themeColor": "#7C1C1C",
      "backgroundColor": "#F8F5F2",
      "display": "standalone",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "CORE needs camera access to capture geo-tagged evidence photos during field visits.",
          "photosPermission": "CORE needs photo library access to attach evidence photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CORE needs your location to geo-tag evidence photos and field visit records."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e654d248-29f9-46d7-bb4b-b06e79a0a4a6"
      }
    }
  }
}
